---
import { Image } from "astro:assets";
import logo from "../../assets/brand/frogg-logo.png";
import { githubPath, repo } from "./site-data";

// Icon paths are 24×24 strokes.
const links = [
  { href: "/docs/", label: "Docs", icon: "M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5v-13ZM13 4h5.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H13V4Z" },
  { href: "/docs/self-hosting/", label: "Self-hosting", icon: "M4 5h16v5H4V5Zm0 9h16v5H4v-5Zm3-6.5h.01M7 16.5h.01" },
  { href: "/docs/fork-and-rebrand/", label: "Fork & rebrand", icon: "M6 3v12M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM18 9a9 9 0 0 1-9 9" },
];
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label="Frogg home">
      <Image src={logo} alt="" width={30} height={23} densities={[1, 2]} loading="eager" fetchpriority="high" />
      <span>FROGG</span>
    </a>
    <a class="pill-link" href={`${repo}/releases`}>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"
        ><path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 19h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
      >
      Releases
    </a>

    <nav class="desktop-nav" aria-label="Main">
      {
        links.map((link) => (
          <a href={link.href}>
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
              <path d={link.icon} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {link.label}
          </a>
        ))
      }
    </nav>

    <a class="star-pill" href={repo} aria-label="Star Frogg on GitHub">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d={githubPath}></path></svg>
      <span>Star on GitHub</span>
      <span class="star-count" hidden>
        <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"
          ><path fill="#f5b84a" d="m12 2.5 2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8L12 2.5Z"></path></svg
        >
        <span class="n"></span>
      </span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Main" hidden>
    {links.map((link, i) => <a href={link.href} style={`--i:${i}`}>{link.label}</a>)}
    <a href={`${repo}/releases`} style={`--i:${links.length}`}>Releases</a>
    <a href={repo} style={`--i:${links.length + 1}`}>GitHub</a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header")!;
  const button = header.querySelector<HTMLButtonElement>(".menu-btn")!;
  const nav = header.querySelector<HTMLElement>("#mobile-nav")!;

  const setOpen = (open: boolean) => {
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    header.classList.toggle("menu-open", open);
    document.documentElement.classList.toggle("no-scroll", open);
    if (open) {
      nav.hidden = false;
      requestAnimationFrame(() => nav.classList.add("open"));
    } else {
      nav.classList.remove("open");
      setTimeout(() => {
        if (!nav.classList.contains("open")) nav.hidden = true;
      }, 220);
    }
  };

  button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
  nav.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && header.classList.contains("menu-open")) {
      setOpen(false);
      button.focus();
    }
  });
  matchMedia("(min-width: 56rem)").addEventListener("change", (e) => e.matches && setOpen(false));

  const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // GitHub star count, cached per session. The pill reads fine without it.
  const count = header.querySelector<HTMLElement>(".star-count")!;
  const show = (n: number) => {
    count.querySelector(".n")!.textContent = n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
    count.hidden = false;
  };
  try {
    const cached = JSON.parse(sessionStorage.getItem("frogg-stars") ?? "null");
    if (cached && Date.now() - cached.t < 3_600_000) show(cached.n);
    else
      fetch("https://api.github.com/repos/frogg-app/frogg")
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          if (typeof d?.stargazers_count !== "number") return;
          sessionStorage.setItem("frogg-stars", JSON.stringify({ n: d.stargazers_count, t: Date.now() }));
          show(d.stargazers_count);
        })
        .catch(() => {});
  } catch {}
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(0 0 0 / 0.96);
    border-bottom: 1px solid transparent;
    transition: border-color var(--frogg-med) var(--frogg-ease);
  }
  .site-header.scrolled,
  .site-header.menu-open {
    border-bottom-color: rgb(255 255 255 / 0.08);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0 auto;
    padding: 0 1.1rem;
    height: 4rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font: 300 1.3rem/1 var(--lp-display);
    letter-spacing: 0.08em;
    color: #f5f5f5;
    text-decoration: none;
  }
  .brand img {
    width: 30px;
    height: auto;
    transition: transform var(--frogg-med) var(--frogg-ease-spring);
  }
  .brand:hover img {
    transform: rotate(-8deg) scale(1.08);
  }
  .pill-link {
    display: none;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.8rem;
    border-radius: 9px;
    border: 1px solid rgb(37 181 200 / 0.28);
    background: rgb(37 181 200 / 0.08);
    font: 400 0.82rem/1 var(--lp-mono);
    color: #e6f7fa;
    text-decoration: none;
    transition:
      background-color var(--frogg-fast) var(--frogg-ease),
      border-color var(--frogg-fast) var(--frogg-ease);
  }
  .pill-link:hover {
    background: rgb(37 181 200 / 0.16);
    border-color: rgb(37 181 200 / 0.5);
  }
  .desktop-nav {
    display: none;
    gap: 1.5rem;
    margin-left: auto;
  }
  .desktop-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font: 400 0.84rem/1 var(--lp-mono);
    color: #e5e5e5;
    text-decoration: none;
    transition: color var(--frogg-fast) var(--frogg-ease);
  }
  .desktop-nav a:hover {
    color: #fff;
  }
  .desktop-nav svg {
    opacity: 0.8;
  }
  .star-pill {
    display: none;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0.35rem 0.3rem 0.85rem;
    min-height: 2.3rem;
    border-radius: 9px;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: #1c1c1e;
    font: 400 0.84rem/1 var(--lp-mono);
    color: #f0f0f0;
    text-decoration: none;
    transition: background-color var(--frogg-fast) var(--frogg-ease);
  }
  .star-pill:hover {
    background: #262628;
  }
  .star-count {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    background: #111;
    font-size: 0.72rem;
    color: #d4d4d4;
  }
  .star-count[hidden] {
    display: none;
  }
  .menu-btn {
    display: inline-grid;
    place-content: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    margin-left: auto;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 9px;
    background: transparent;
    cursor: pointer;
  }
  .menu-btn span {
    display: block;
    width: 16px;
    height: 1.5px;
    border-radius: 2px;
    background: #f5f5f5;
    transition: transform var(--frogg-med) var(--frogg-ease);
  }
  .menu-open .menu-btn span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .menu-open .menu-btn span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }
  .mobile-nav {
    display: grid;
    gap: 0.25rem;
    padding: 0.5rem 1.25rem 1.25rem;
    height: calc(100dvh - 4rem);
    align-content: start;
    overflow-y: auto;
    background: #000;
  }
  .mobile-nav[hidden] {
    display: none;
  }
  .mobile-nav a {
    padding: 1rem 0.25rem;
    font: 400 1.5rem/1.2 var(--lp-display);
    letter-spacing: -0.03em;
    color: #f5f5f5;
    text-decoration: none;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 200ms var(--frogg-ease),
      transform 260ms var(--frogg-ease);
    transition-delay: calc(var(--i) * 30ms);
  }
  .mobile-nav.open a {
    opacity: 1;
    transform: none;
  }
  @media (min-width: 40rem) {
    .pill-link {
      display: inline-flex;
    }
  }
  @media (min-width: 56rem) {
    .desktop-nav,
    .star-pill {
      display: flex;
    }
    .menu-btn,
    .mobile-nav {
      display: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav a {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
