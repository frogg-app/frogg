---
import { Image } from "astro:assets";
import logo from "../../assets/brand/frogg-logo.png";
import { githubPath, repo } from "./site-data";

const columns = [
  {
    title: "Product",
    links: [
      { href: "/#download", label: "Download" },
      { href: "/docs/getting-started/", label: "Getting started" },
      { href: "/docs/self-hosting/", label: "Self-hosting" },
      { href: "/docs/", label: "Docs" },
      { href: `${repo}/blob/main/CHANGELOG.md`, label: "Changelog" },
    ],
  },
  {
    title: "Community",
    links: [
      { href: repo, label: "GitHub" },
      { href: `${repo}/issues`, label: "Issues" },
      { href: "/docs/contributing/", label: "Guide for contribution" },
      { href: "/docs/fork-and-rebrand/", label: "Fork & rebrand" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: `${repo}/releases`, label: "Releases" },
      { href: `${repo}/blob/main/LICENSE`, label: "Apache-2.0 License" },
      { href: `${repo}/blob/main/SECURITY.md`, label: "Security" },
      { href: "/llms.txt", label: "llms.txt" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="backdrop" aria-hidden="true">
  </div>
  <div class="inner">
    <div class="about">
      <a class="brand" href="/">
        <Image src={logo} alt="" width={40} height={31} densities={[1, 2]} />
        <span>FROGG</span>
      </a>
      <p>The open-source home for your coding agents.</p>
      <div class="socials">
        <a href={repo} aria-label="Frogg on GitHub">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={githubPath}></path></svg>
        </a>
        <a href={`${repo}/releases`} aria-label="Frogg releases">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 19h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg
          >
        </a>
        <a href="/docs/" aria-label="Frogg docs">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5v-13ZM13 4h5.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H13V4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg
          >
        </a>
      </div>
    </div>
    {
      columns.map((col) => (
        <nav aria-label={col.title}>
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    <div class="legal">
      <p>© {new Date().getFullYear()} Frogg · Open source under the Apache-2.0 License</p>
      <p class="fine">
        Frogg is a fork of <a href="https://github.com/getpaseo/paseo">Paseo</a>. Claude, Codex, GitHub Copilot and
        other names are trademarks of their owners; Frogg is not affiliated with them.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 6rem;
    padding-top: 6rem;
    background: #000;
  }
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .inner {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 82rem;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 5vw, 4.5rem) 3rem;
  }
  .about {
    grid-column: 1 / -1;
  }
  @media (min-width: 52rem) {
    .inner {
      grid-template-columns: 1.6fr repeat(3, minmax(0, 1fr));
    }
    .about {
      grid-column: auto;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font: 300 2rem/1 var(--lp-display);
    letter-spacing: 0.08em;
    color: #f5f5f5;
    text-decoration: none;
  }
  .brand img {
    width: 40px;
    height: auto;
  }
  .about p {
    margin: 1.1rem 0 0;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: #e5e5e5;
  }
  .socials {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.14);
    color: #fff;
    transition: background-color var(--frogg-fast) var(--frogg-ease);
  }
  .socials a:hover {
    background: rgb(255 255 255 / 0.24);
  }
  h2 {
    margin: 0.4rem 0 1.1rem;
    font: 400 0.75rem/1 var(--lp-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #a3a3a3;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  ul a {
    font-size: 1.02rem;
    letter-spacing: -0.02em;
    color: #f5f5f5;
    text-decoration: none;
    transition: color var(--frogg-fast) var(--frogg-ease);
  }
  ul a:hover {
    color: var(--frogg-accent-bright);
  }
  .legal {
    grid-column: 1 / -1;
    margin-top: clamp(4rem, 14vw, 12rem);
  }
  .legal p {
    margin: 0;
    font: 400 0.78rem/1.5 var(--lp-mono);
    color: #e5e5e5;
  }
  .legal .fine {
    margin-top: 0.4rem;
    max-width: 44rem;
    font-size: 0.66rem;
    color: #8a8a8a;
  }
  .legal a {
    color: inherit;
  }
</style>
