---
import SiteLayout from "../layouts/SiteLayout.astro";
import AppWindow from "../components/site/AppWindow.astro";
import InstallCommand from "../components/site/InstallCommand.astro";
import ProviderIcon from "../components/site/ProviderIcon.astro";
import { Image } from "astro:assets";
import logo from "../assets/brand/frogg-logo.png";
import { platforms, repo } from "../components/site/site-data";

const heroPlatforms = platforms.filter((p) => ["mac", "linux", "windows", "android"].includes(p.id));

type Provider = "claude" | "codex" | "copilot" | "opencode" | "pi" | "omp" | "acp";
const carousel: Provider[] = ["omp", "copilot", "codex", "claude", "opencode", "pi", "acp"];

const chips = [
  { label: "Isolated worktrees", icon: "M6 3v12M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM18 9a9 9 0 0 1-9 9" },
  { label: "Terminals on the host", icon: "m5 8 4 4-4 4M12 16h7" },
  { label: "Schedules & heartbeats", icon: "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" },
  { label: "Voice companion", icon: "M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3ZM5 11a7 7 0 0 0 14 0M12 18v3" },
];

const tiles: { name: string; sub: string; provider?: Provider; icon?: string }[] = [
  { name: "Claude Code", sub: "Anthropic · your plan", provider: "claude" },
  { name: "Codex", sub: "OpenAI · ChatGPT plan", provider: "codex" },
  { name: "OpenCode", sub: "Any model", provider: "opencode" },
  { name: "GitHub Copilot", sub: "Copilot plan", provider: "copilot" },
  { name: "Pi", sub: "Agent CLI", provider: "pi" },
  { name: "Oh My Pi", sub: "Agent CLI", provider: "omp" },
  { name: "Any ACP agent", sub: "Agent Client Protocol", provider: "acp" },
  { name: "Terminals", sub: "Shells · next to agents", icon: "m5 8 4 4-4 4M12 16h7" },
  { name: "Schedules", sub: "Cron · heartbeats", icon: "M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" },
  { name: "Companion", sub: "Voice · hands-free", icon: "M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3ZM5 11a7 7 0 0 0 14 0M12 18v3" },
];

const faqs = [
  {
    q: "Is Frogg free?",
    a: "Yes. Frogg is open source under Apache-2.0. You host the daemon yourself, so there is no Frogg subscription or seat fee.",
  },
  {
    q: "Which agents does it run?",
    a: "Claude Code, Codex, OpenCode, GitHub Copilot, Pi, Oh My Pi and any ACP-compatible agent. Run several side by side, each in its own worktree.",
  },
  {
    q: "Do I need an API key?",
    a: "No. Frogg uses the sign-in your agent CLI already has on the host, including your existing Claude or ChatGPT plan. You can keep several accounts per provider and switch between them.",
  },
  {
    q: "Where does my code run?",
    a: "On the machine that runs the daemon: your laptop, a home server or a VM. Desktop, phone, browser and CLI are clients that connect to it.",
  },
  {
    q: "Can I ship my own build?",
    a: "Yes. One brand.json changes the name, icon, colours, app IDs and update feed, and you keep pulling upstream Frogg.",
  },
];

const downloadIcon = "M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 19h16";
---

<SiteLayout
  title="Frogg: run and monitor coding agents from anywhere"
  description="Frogg runs Claude Code, Codex, OpenCode and more on a daemon you host, and lets you watch, steer and approve them from desktop, phone, browser or CLI."
>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="sky" aria-hidden="true">
      <canvas class="facets"></canvas>
      <span class="tint"></span>
      <span class="veil"></span>
      <canvas class="stars"></canvas>
      <span class="sky-glow"></span>
    </div>

    <div class="hero-inner">
      <p class="tag">Open-source <span aria-hidden="true">•</span> Apache-2.0 License</p>
      <h1>Your coding agents,<br /><span class="shine">wherever</span> you are</h1>

      <p class="dl-label">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
          ><path d={downloadIcon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
        Download for
      </p>
      <div class="dl-row">
        {
          heroPlatforms.map((p, i) => (
            <a class:list={["btn dl-btn", { "btn-primary": i === 0 }]} href={p.href} data-platform-btn={p.id}>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path fill="currentColor" d={p.icon} />
              </svg>
              {p.name}
            </a>
          ))
        }
      </div>
      <div class="hero-install">
        <InstallCommand />
      </div>
    </div>

    <div class="hero-shot">
      <div class="shot-frame">
        <AppWindow />
      </div>
    </div>
  </section>

  <!-- ================= BENTO ================= -->
  <section id="features" class="bento" aria-label="Features">
    <!-- Agents -->
    <article class="tile" data-reveal>
      <header>
        <h2>Every agent,<br />one timeline</h2>
        <p>Run them side by side<br />and follow every turn live</p>
      </header>
      <div class="viz viz-flow" aria-hidden="true">
        <div class="ask">
          <p>"Add rate limiting to uploads, fix the flaky CI job and polish dark mode."</p>
          <strong>You asked</strong>
        </div>
        <svg class="bracket" viewBox="0 0 40 220" preserveAspectRatio="none">
          <path d="M0 110 H18 M18 20 V200 M18 20 H40 M18 110 H40 M18 200 H40"></path>
        </svg>
        <div class="tasks">
          <div class="task on">
            <span class="task-head"><ProviderIcon name="claude" size={13} /> Rate-limit uploads</span>
            <span class="state run">Working</span>
          </div>
          <div class="task on">
            <span class="task-head"><ProviderIcon name="codex" size={13} /> Fix flaky CI job</span>
            <span class="state wait">Needs approval</span>
          </div>
          <div class="task dim">
            <span class="task-head"><ProviderIcon name="opencode" size={13} /> Dark mode polish</span>
            <span class="state done">Done</span>
          </div>
        </div>
      </div>
    </article>

    <!-- Approvals -->
    <article class="tile" data-reveal style="--reveal-delay:80">
      <header>
        <h2>Approve from<br />anywhere</h2>
        <p>Prompts reach whichever device<br />you have in hand</p>
      </header>
      <div class="viz viz-panel" aria-hidden="true">
        <div class="panel">
          <div class="panel-tabs"><span class="on">Waiting</span><span>Answered</span></div>
          <strong class="panel-title">Needs you</strong>
          <span class="panel-sub">From build-box, paired over Tailscale.</span>
          <div class="perm">
            <ProviderIcon name="codex" size={18} />
            <div><b>Codex wants to run</b><code>npm run test:ci -- --repeat 20</code></div>
            <span class="perm-actions"><span>Deny</span><span class="allow">Allow</span></span>
          </div>
          <div class="perm">
            <ProviderIcon name="claude" size={18} />
            <div><b>Claude wants to push</b><code>feat/upload-limits → origin</code></div>
            <span class="perm-actions"><span>Deny</span><span class="allow">Allow</span></span>
          </div>
          <span class="panel-foot">Scan once to pair a phone</span>
        </div>
      </div>
    </article>

    <!-- Subscriptions -->
    <article class="tile" data-reveal>
      <header>
        <h2>Use your own<br />subscription</h2>
        <p>Your Claude or ChatGPT plan,<br />or any ACP agent</p>
      </header>
      <div class="viz viz-stage" aria-hidden="true">
        <div class="pedestals">
          <div class="ped">
            <span class="float"><ProviderIcon name="claude" size={54} /></span>
            <span class="ring"></span>
            <span class="ped-pill on"><i class="dots"></i>Signed in</span>
          </div>
          <div class="ped">
            <span class="float" style="--d:-1.2s"><ProviderIcon name="codex" size={54} /></span>
            <span class="ring"></span>
            <span class="ped-pill">Connect ChatGPT</span>
          </div>
          <div class="ped">
            <span class="float" style="--d:-2.4s"><ProviderIcon name="acp" size={54} /></span>
            <span class="ring"></span>
            <span class="ped-pill">Add an ACP agent</span>
          </div>
        </div>
      </div>
    </article>

    <!-- Rebrand -->
    <article class="tile" data-reveal style="--reveal-delay:80">
      <header>
        <h2>Fork it.<br />Ship your own.</h2>
        <p>Branding is one JSON file,<br />and you keep pulling upstream</p>
      </header>
      <div class="viz viz-diff" aria-hidden="true">
        <div class="sheet back2"><span>release.yml</span></div>
        <div class="sheet back1"><span>brand.schema.json</span></div>
        <div class="sheet front">
          <div class="file">
            <svg viewBox="0 0 24 24" width="15" height="15"
              ><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Zm0 0v5h5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg
            >
            brands/<b>acme/brand.json</b>
          </div>
          <div class="lines">
            <div><i>2</i><span><em>"applicationId"</em>: "com.acme.studio",</span></div>
            <div class="del"><i>−</i><span>"name": "Frogg",</span></div>
            <div class="add"><i>+</i><span>"name": "<span class="typed">Acme Studio</span>",<span class="caret"></span></span></div>
            <div><i>4</i><span><em>"accent"</em>: "#c4b5fd"</span></div>
          </div>
          <div class="status"><span class="pulse"></span>Rebranding…</div>
        </div>
      </div>
    </article>

    <!-- Platforms (full width) -->
    <article id="download" class="tile wide" data-reveal>
      <header>
        <h2>Every screen drives it</h2>
        <p>Install the daemon once, then connect from anything</p>
        <div class="wide-install"><InstallCommand label="Copy daemon install command" /></div>
      </header>
      <div class="viz viz-stage wide-stage">
        <ul class="pedestals">
          {
            platforms.map((p, i) => (
              <li class="ped" data-platform={p.id}>
                <span class="float" style={`--d:${-i * 0.7}s`} aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="56" height="56">
                    {p.fill ? (
                      <path d={p.icon} fill="currentColor" />
                    ) : (
                      <path d={p.icon} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    )}
                  </svg>
                </span>
                <span class="ring" aria-hidden="true"></span>
                <a class="ped-pill" href={p.href}>
                  {p.fill ? "Get" : "Open"} {p.name}
                </a>
                <span class="ped-sub">{p.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </article>
  </section>

  <!-- ================= HUB ================= -->
  <section id="agents" class="hub" aria-labelledby="hub-title">
    <h2 id="hub-title" class="hub-title" data-reveal>One daemon<br />for every coding agent</h2>
    <ul class="chips" data-reveal>
      {
        chips.map((c) => (
          <li>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d={c.icon} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {c.label}
          </li>
        ))
      }
    </ul>

    <div class="hub-diagram" aria-hidden="true">
      <div class="carousel">
        {
          carousel.map((name, i) => (
            <span class="car" style={`--o:${i - 3}`}>
              <ProviderIcon name={name} size={30} />
            </span>
          ))
        }
      </div>
      <p class="car-label">your agents, your sign-ins</p>
      <span class="stem"></span>
      <span class="hub-pill">
        <Image src={logo} alt="" width={28} height={22} densities={[1, 2]} />
        FROGG
      </span>
      <svg class="fan" viewBox="0 0 1000 120" preserveAspectRatio="none">
        <path d="M500 0 C500 70 100 50 100 120"></path>
        <path d="M500 0 C500 70 300 50 300 120"></path>
        <path d="M500 0 V120"></path>
        <path d="M500 0 C500 70 700 50 700 120"></path>
        <path d="M500 0 C500 70 900 50 900 120"></path>
      </svg>
    </div>

    <ul class="tiles">
      {
        tiles.map((t, i) => (
          <li class:list={["mini", { hot: i === 0 }]} data-reveal style={`--reveal-delay:${(i % 5) * 40}`}>
            <span class="mini-icon" aria-hidden="true">
              {t.provider ? (
                <ProviderIcon name={t.provider} size={18} />
              ) : (
                <svg viewBox="0 0 24 24" width="18" height="18">
                  <path d={t.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </span>
            <span class="mini-text">
              <strong>{t.name}</strong>
              <span>{t.sub}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ================= CLOSING CTA ================= -->
  <section class="closing">
    <div class="sky" aria-hidden="true">
      <canvas class="facets"></canvas>
      <span class="tint"></span>
      <span class="veil"></span>
      <canvas class="stars"></canvas>
      <span class="sky-glow"></span>
    </div>
    <div class="hero-inner" data-reveal>
      <h2 class="closing-title">Put your agents to work,<br />from anywhere</h2>
      <p class="dl-label">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"
          ><path d={downloadIcon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
        Download for
      </p>
      <div class="dl-row">
        {
          heroPlatforms.map((p, i) => (
            <a class:list={["btn dl-btn", { "btn-primary": i === 0 }]} href={p.href} data-platform-btn={p.id}>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path fill="currentColor" d={p.icon} />
              </svg>
              {p.name}
            </a>
          ))
        }
      </div>
      <p class="closing-links">
        <a href="/docs/contributing/">Guide for contribution</a>
        <span aria-hidden="true">•</span>
        <a href={`${repo}/blob/main/LICENSE`}>Apache-2.0 License</a>
      </p>
    </div>
  </section>

  <!-- ================= FAQ ================= -->
  <section id="faq" class="faq" aria-labelledby="faq-title">
    <h2 id="faq-title" class="faq-title">Questions</h2>
    <div class="faq-list">
      {
        faqs.map((f) => (
          <details>
            <summary>
              {f.q}
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</SiteLayout>

<script>
  import { mountFacets } from "../scripts/facets";

  // Low-poly terrain from frogg.dev. Stays on the black fallback if WebGL2 is unavailable.
  document.querySelectorAll<HTMLCanvasElement>("canvas.facets").forEach((c) => {
    try {
      mountFacets(c);
    } catch (e) {
      console.warn("facets disabled", e);
    }
  });

  // Promote the visitor's platform to the primary download button.
  const ua = navigator.userAgent;
  const os = /android/i.test(ua)
    ? "android"
    : /iphone|ipad|ipod/i.test(ua)
      ? null
      : /mac/i.test(ua)
        ? "mac"
        : /win/i.test(ua)
          ? "windows"
          : /linux/i.test(ua)
            ? "linux"
            : null;
  if (os) {
    document.querySelectorAll<HTMLElement>(".dl-row").forEach((row) => {
      const mine = row.querySelector<HTMLElement>(`[data-platform-btn="${os}"]`);
      if (!mine) return;
      row.querySelectorAll(".dl-btn").forEach((b) => b.classList.remove("btn-primary"));
      mine.classList.add("btn-primary");
      row.prepend(mine);
    });
    document.querySelector(`.ped[data-platform="${os}"]`)?.classList.add("mine");
  }

  // Twinkling starfield. Static frame for reduced motion; paused while off screen.
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLCanvasElement>("canvas.stars").forEach((canvas) => {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    type Star = { x: number; y: number; r: number; a: number; s: number; p: number };
    let stars: Star[] = [];
    let w = 0;
    let h = 0;
    let raf = 0;
    let visible = false;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const resize = () => {
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round((w * h) / 9000);
      stars = Array.from({ length: n }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 1.1 + 0.3,
        a: Math.random() * 0.6 + 0.2,
        s: Math.random() * 0.0015 + 0.0004,
        p: Math.random() * Math.PI * 2,
      }));
    };
    const draw = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = "#cfe9ee";
      for (const s of stars) {
        const tw = reduced ? 1 : 0.55 + 0.45 * Math.sin(t * s.s + s.p);
        ctx.globalAlpha = s.a * tw;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();
      }
    };
    const loop = (t: number) => {
      draw(t);
      if (visible && !reduced) raf = requestAnimationFrame(loop);
    };
    resize();
    draw(0);
    new ResizeObserver(() => {
      resize();
      draw(performance.now());
    }).observe(canvas);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      cancelAnimationFrame(raf);
      if (visible && !reduced) raf = requestAnimationFrame(loop);
    }).observe(canvas);
  });

  // Rotate the provider carousel.
  const cars = [...document.querySelectorAll<HTMLElement>(".car")];
  if (cars.length && !reduced) {
    const n = cars.length;
    const half = Math.floor(n / 2);
    let shift = 0;
    setInterval(() => {
      shift = (shift + 1) % n;
      cars.forEach((c, i) => {
        const o = ((((i - half - shift) % n) + n + half) % n) - half;
        c.style.setProperty("--o", String(o));
      });
    }, 2400);
  }
</script>

<style>
  /* ---------- Sky (hero + closing) ---------- */
  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .sky-glow {
    position: absolute;
    left: 50%;
    top: 4%;
    width: min(64rem, 120vw);
    height: 34rem;
    translate: -50% 0;
    background:
      radial-gradient(closest-side at 50% 55%, rgb(37 181 200 / 0.24), transparent 70%),
      radial-gradient(closest-side at 50% 60%, rgb(62 123 250 / 0.2), transparent 85%);
    filter: blur(6px);
  }
  /* Terrain from frogg.dev, feathered on every edge so it dissolves into the page. */
  .facets {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    mix-blend-mode: screen;
    -webkit-mask-image:
      linear-gradient(180deg, transparent 8%, #000 42%, #000 66%, transparent 94%),
      linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(180deg, transparent 8%, #000 42%, #000 66%, transparent 94%),
      linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
    mask-composite: intersect;
    transition: opacity 2s var(--frogg-ease);
  }
  .facets:global(.is-live) {
    opacity: 0.9;
  }
  /* Colour wash over the mesh: cyan core, a violet edge like frogg.dev, deep blue at the flanks. */
  .tint {
    position: absolute;
    inset: 0;
    mix-blend-mode: soft-light;
    background:
      radial-gradient(40% 35% at 50% 62%, rgb(127 217 230 / 0.9), transparent 70%),
      radial-gradient(35% 40% at 82% 48%, rgb(139 124 246 / 0.85), transparent 70%),
      radial-gradient(40% 45% at 14% 58%, rgb(4 91 157 / 0.9), transparent 75%);
  }
  /* Darken behind the copy so it stays legible over the brightest facets. */
  .veil {
    position: absolute;
    inset: 0;
    background: radial-gradient(42% 30% at 50% 36%, rgb(0 0 0 / 0.72), transparent 85%);
  }
  .closing .veil {
    background: radial-gradient(42% 34% at 50% 40%, rgb(0 0 0 / 0.72), transparent 85%);
  }
  .closing .facets {
    -webkit-mask-image:
      linear-gradient(180deg, transparent 8%, #000 38%, #000 55%, transparent 88%),
      linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
    mask-image:
      linear-gradient(180deg, transparent 8%, #000 38%, #000 55%, transparent 88%),
      linear-gradient(90deg, transparent 0%, #000 18%, #000 82%, transparent 100%);
  }
  .stars {
    -webkit-mask-image: linear-gradient(#000 25%, transparent 55%);
    mask-image: linear-gradient(#000 25%, transparent 55%);
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(3rem, 8vw, 4.25rem) 1.25rem 0;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.35rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgb(127 217 230 / 0.35);
    background: rgb(37 181 200 / 0.14);
    font: 400 0.8rem/1 var(--lp-mono);
    color: #e3f6f9;
    animation: rise 700ms var(--frogg-ease) 60ms both;
  }
  .tag span {
    color: var(--lp-accent);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 6.4vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.055em;
    font-weight: 400;
    text-wrap: balance;
    animation: rise 800ms var(--frogg-ease) 120ms both;
  }
  .shine {
    background: linear-gradient(100deg, #fff 20%, #9be6f1 45%, #fff 70%);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 6s linear infinite;
  }
  .dl-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 2.6rem 0 1rem;
    color: #d4d4d4;
    font-size: 1rem;
    animation: rise 800ms var(--frogg-ease) 200ms both;
  }
  .dl-row {
    max-width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    animation: rise 800ms var(--frogg-ease) 260ms both;
  }
  .dl-btn {
    min-width: 7.5rem;
    min-height: 2.6rem;
  }
  .hero-install {
    width: min(100%, 30rem);
    min-width: 0;
    margin-top: 1.75rem;
    opacity: 0.85;
    animation: rise 800ms var(--frogg-ease) 320ms both;
  }
  .hero-shot {
    position: relative;
    max-width: 62rem;
    margin: clamp(2.5rem, 6vw, 4.5rem) auto 0;
    animation: rise 1000ms var(--frogg-ease) 380ms both;
  }
  .hero-shot::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 24px;
    padding: 1px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.04) 40%, rgb(37 181 200 / 0.35));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: 2;
  }
  .hero-shot::after {
    content: "";
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -3rem;
    height: 6rem;
    background: radial-gradient(closest-side, rgb(37 181 200 / 0.35), transparent);
    filter: blur(20px);
    z-index: -1;
  }
  .shot-frame {
    overflow: hidden;
    border-radius: 24px;
    background: #0a0a0b;
    padding: clamp(0.5rem, 1.5vw, 1rem);
  }
  .shot-frame :global(.app-window) {
    border-radius: 14px;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes shine {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: -120% 0;
    }
  }

  /* ---------- Bento ---------- */
  .bento {
    display: grid;
    gap: 1.5rem;
    max-width: 80rem;
    margin: clamp(5rem, 10vw, 8rem) auto 0;
    padding: 0 clamp(1rem, 4vw, 4.5rem);
  }
  @media (min-width: 60rem) {
    .bento {
      grid-template-columns: 1fr 1fr;
    }
    .tile.wide {
      grid-column: 1 / -1;
    }
  }
  .tile {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 32rem;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border-radius: 24px;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: #000;
  }
  .tile::after {
    content: "";
    position: absolute;
    inset: auto -10% -30% -10%;
    height: 70%;
    z-index: -1;
    background: radial-gradient(60% 60% at 50% 100%, rgb(37 120 200 / 0.22), transparent 70%);
    pointer-events: none;
  }
  .tile h2 {
    margin: 0;
    font-size: clamp(1.8rem, 2.6vw, 2.15rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 400;
  }
  .tile header p {
    margin: 1rem 0 0;
    font-size: 1.12rem;
    line-height: 1.35;
    color: #d4d4d4;
  }
  .viz {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    margin-top: 1.75rem;
    min-height: 18rem;
  }

  /* Agents flow */
  .viz-flow {
    grid-template-columns: auto auto auto;
    justify-content: center;
    align-items: center;
  }
  .ask,
  .task {
    border-radius: 10px;
    border: 1.5px solid rgb(62 160 250 / 0.75);
    background: linear-gradient(180deg, #1a1d22, #0c0d10);
    box-shadow:
      0 0 0 3px rgb(62 160 250 / 0.12),
      0 10px 30px -10px rgb(37 181 200 / 0.4);
  }
  .ask {
    width: 9.5rem;
    padding: 0.75rem;
    font-size: 0.68rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .ask p {
    margin: 0 0 1rem;
    color: #e5e5e5;
  }
  .ask strong {
    font-weight: 500;
    font-size: 0.72rem;
  }
  .bracket {
    width: 2.5rem;
    height: 13.5rem;
  }
  .bracket path {
    fill: none;
    stroke: rgb(127 190 250 / 0.65);
    stroke-width: 1.4;
    stroke-dasharray: 3 4;
    vector-effect: non-scaling-stroke;
    animation: flow 1.4s linear infinite;
  }
  .tasks {
    display: grid;
    gap: 0.6rem;
  }
  .task {
    display: grid;
    gap: 0.6rem;
    width: 11rem;
    padding: 0.85rem 0.75rem 0.7rem;
    font-size: 0.74rem;
  }
  .task-head {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
  }
  .task.dim {
    opacity: 0.35;
    border-color: rgb(255 255 255 / 0.15);
    box-shadow: none;
  }
  .state {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.66rem;
  }
  .state::before {
    content: "";
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: currentColor;
  }
  .state.run {
    color: #7fb6ff;
  }
  .state.run::before {
    animation: blink 1.2s ease-in-out infinite;
  }
  .state.wait {
    color: var(--frogg-warning);
  }
  .state.done {
    color: var(--frogg-success);
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -14;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  /* Approvals panel */
  .viz-panel {
    perspective: 1200px;
    place-items: end center;
  }
  .panel {
    width: min(100%, 31rem);
    margin-bottom: -2.6rem;
    padding: 0.9rem 1.25rem 1.5rem;
    border-radius: 14px 14px 0 0;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: linear-gradient(180deg, #0f1012, #08090a);
    transform: rotateX(10deg) rotateZ(-1.2deg);
    transform-origin: 50% 100%;
    font-size: 0.78rem;
    box-shadow: 0 -20px 60px -30px rgb(37 181 200 / 0.4);
  }
  .panel-tabs {
    display: flex;
    gap: 0.3rem;
    font: 400 0.7rem/1 var(--lp-mono);
    color: #a3a3a3;
  }
  .panel-tabs span {
    padding: 0.4rem 0.55rem;
    border-radius: 6px;
  }
  .panel-tabs .on {
    background: rgb(255 255 255 / 0.08);
    color: #fff;
  }
  .panel-title {
    display: block;
    margin-top: 1rem;
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: -0.04em;
  }
  .panel-sub {
    display: block;
    margin-top: 0.15rem;
    color: #a3a3a3;
    font-size: 0.72rem;
  }
  .perm {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.85rem;
    padding: 0.7rem 0.75rem;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.06);
  }
  .perm b {
    display: block;
    font-weight: 500;
  }
  .perm code {
    font: 400 0.68rem/1.4 var(--lp-mono);
    color: #a3a3a3;
  }
  .perm-actions {
    display: flex;
    gap: 0.35rem;
    font: 400 0.68rem/1 var(--lp-mono);
  }
  .perm-actions span {
    padding: 0.45rem 0.6rem;
    border-radius: 7px;
    background: rgb(255 255 255 / 0.07);
  }
  .perm-actions .allow {
    background: var(--lp-accent);
    color: #021418;
    animation: nudge 2.4s ease-in-out infinite;
  }
  .panel-foot {
    display: block;
    margin-top: 1.1rem;
    font: 400 0.68rem/1 var(--lp-mono);
    color: #737373;
  }
  @keyframes nudge {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgb(37 181 200 / 0);
    }
    50% {
      box-shadow: 0 0 0 5px rgb(37 181 200 / 0.18);
    }
  }

  /* Stage: floating icons on rings */
  .viz-stage {
    place-items: end center;
    padding-bottom: 1rem;
  }
  .pedestals {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ped {
    position: relative;
    display: grid;
    justify-items: center;
    flex: 1 1 0;
    min-width: 8.5rem;
    max-width: 11rem;
  }
  .float {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    color: #f5f5f5;
    filter: drop-shadow(0 0 14px rgb(37 181 200 / 0.55)) drop-shadow(0 6px 10px rgb(0 0 0 / 0.8));
    animation: bob 4.8s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }
  .ring {
    width: 6rem;
    height: 2.4rem;
    margin-top: -0.6rem;
    border-radius: 50%;
    border: 2px solid rgb(255 255 255 / 0.22);
    box-shadow:
      inset 0 0 0 8px rgb(0 0 0 / 0.6),
      inset 0 0 0 9px rgb(255 255 255 / 0.14);
    background: radial-gradient(closest-side, rgb(37 181 200 / 0.12), transparent);
  }
  .ped-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    margin-top: 1.5rem;
    padding: 0.65rem 0.6rem;
    border-radius: 6px;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: #1a1a1a;
    font: 400 0.76rem/1 var(--lp-mono);
    color: #f5f5f5;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--frogg-fast) var(--frogg-ease),
      border-color var(--frogg-fast) var(--frogg-ease);
  }
  a.ped-pill:hover {
    background: #262626;
    border-color: rgb(255 255 255 / 0.2);
  }
  .ped-pill.on,
  .ped.mine .ped-pill {
    background: rgb(37 181 200 / 0.16);
    border-color: rgb(37 181 200 / 0.45);
    color: #e3f6f9;
  }
  .dots {
    width: 0.7rem;
    height: 0.7rem;
    background-image: radial-gradient(circle, currentColor 1px, transparent 1.4px);
    background-size: 3.5px 3.5px;
    animation: blink 1.4s ease-in-out infinite;
  }
  .ped-sub {
    margin-top: 0.55rem;
    font: 400 0.68rem/1.2 var(--lp-mono);
    color: #8a8a8a;
    text-align: center;
  }
  @keyframes bob {
    50% {
      transform: translateY(-8px);
    }
  }

  /* Diff stack */
  .sheet {
    position: absolute;
    width: min(88%, 21rem);
    border-radius: 12px;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: #0b0c0e;
  }
  .sheet > span {
    display: block;
    padding: 0.6rem 0.9rem;
    font: 400 0.7rem/1 var(--lp-mono);
    color: #525252;
  }
  .back2 {
    height: 13rem;
    translate: 3.2rem -4.2rem;
    opacity: 0.35;
  }
  .back1 {
    height: 13rem;
    translate: 1.6rem -2.2rem;
    opacity: 0.6;
  }
  .front {
    position: relative;
    border: 1.5px solid rgb(62 160 250 / 0.75);
    box-shadow:
      0 0 0 3px rgb(62 160 250 / 0.12),
      0 20px 50px -20px rgb(37 181 200 / 0.5);
    font: 400 0.76rem/1 var(--lp-mono);
  }
  .file {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    color: #a3a3a3;
  }
  .file b {
    color: #f5f5f5;
    font-weight: 500;
  }
  .lines {
    padding: 0.5rem 0;
  }
  .lines div {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    align-items: center;
    min-height: 1.75rem;
  }
  .lines i {
    font-style: normal;
    text-align: center;
    color: #525252;
  }
  .lines em {
    font-style: normal;
    color: #7fd9e6;
  }
  .lines .del {
    background: rgb(248 113 113 / 0.14);
    color: #fca5a5;
  }
  .lines .del span {
    text-decoration: line-through;
  }
  .lines .del i {
    color: #f87171;
  }
  .lines .add {
    background: rgb(63 207 142 / 0.12);
    color: #bbf7d0;
  }
  .lines .add i {
    color: var(--frogg-success);
  }
  .typed {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    white-space: nowrap;
    animation: type 5s steps(11) infinite;
  }
  .caret {
    display: inline-block;
    width: 1.5px;
    height: 0.95em;
    margin-left: 2px;
    vertical-align: -0.1em;
    background: #e5e5e5;
    animation: blink 1s steps(1) infinite;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 0.9rem;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    font: 400 0.9rem/1 var(--lp-display);
    color: #7fb6ff;
  }
  .pulse {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
    animation: blink 1.2s ease-in-out infinite;
  }
  @keyframes type {
    0% {
      width: 0;
    }
    40%,
    85% {
      width: 11ch;
    }
    100% {
      width: 0;
    }
  }

  /* Wide platforms card */
  .tile.wide {
    min-height: 0;
  }
  .wide-install {
    width: min(100%, 30rem);
    margin-top: 1.5rem;
  }
  .wide-stage {
    min-height: 0;
    margin-top: 3rem;
    padding: 2rem 0 0.5rem;
  }

  /* ---------- Hub ---------- */
  .hub {
    display: grid;
    justify-items: center;
    padding: clamp(8rem, 16vw, 14rem) 1.25rem 2rem;
    text-align: center;
  }
  .hub-title {
    margin: 0;
    font-size: clamp(2.4rem, 5.2vw, 3.75rem);
    line-height: 1.04;
    letter-spacing: -0.055em;
    font-weight: 400;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    max-width: 38rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    border-radius: 10px;
    border: 1px solid rgb(255 255 255 / 0.08);
    background: #0b0b0c;
    font-size: 1.02rem;
  }
  .chips svg {
    color: var(--lp-accent);
  }
  .hub-diagram {
    position: relative;
    display: grid;
    justify-items: center;
    width: min(100%, 62rem);
    margin-top: 4rem;
  }
  .carousel {
    position: relative;
    width: 100%;
    height: 7rem;
    overflow: hidden;
  }
  .car {
    --abs: max(var(--o), -1 * var(--o));
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 5.25rem;
    height: 5.25rem;
    border-radius: 18px;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: linear-gradient(180deg, #151517, #0a0a0b);
    color: #f5f5f5;
    transform: translate(calc(-50% + var(--o) * 5.4rem), -50%) scale(calc(1.25 - var(--abs) * 0.17));
    opacity: calc(1 - var(--abs) * 0.28);
    filter: blur(calc(max(var(--abs) - 1, 0) * 1.5px));
    z-index: calc(10 - var(--abs));
    transition:
      transform 700ms var(--frogg-ease),
      opacity 700ms var(--frogg-ease),
      filter 700ms var(--frogg-ease);
  }
  .car-label {
    margin: 1.25rem 0 0;
    font: 400 0.8rem/1 var(--lp-mono);
    color: #d4d4d4;
  }
  .stem {
    width: 1px;
    height: 4rem;
    margin-top: 1rem;
    background: linear-gradient(rgb(255 255 255 / 0.35), rgb(255 255 255 / 0.15));
  }
  .hub-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.25);
    background: #0a0a0b;
    font: 300 1.5rem/1 var(--lp-display);
    letter-spacing: 0.08em;
    box-shadow: 0 0 80px 10px rgb(37 120 200 / 0.25);
  }
  .hub-pill img {
    width: 28px;
    height: auto;
  }
  .fan {
    width: 100%;
    height: 7rem;
  }
  .fan path {
    fill: none;
    stroke: rgb(127 190 250 / 0.45);
    stroke-width: 1.2;
    stroke-dasharray: 3 5;
    vector-effect: non-scaling-stroke;
    animation: flow 1.6s linear infinite;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.6rem;
    width: min(100%, 64rem);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  @media (min-width: 64rem) {
    .tiles {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .mini {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.75rem;
    border-radius: 10px;
    border: 1px solid rgb(255 255 255 / 0.1);
    background: #050505;
  }
  .mini.hot {
    border-color: rgb(62 140 250 / 0.7);
    background: linear-gradient(180deg, rgb(62 123 250 / 0.12), rgb(62 123 250 / 0.03));
    box-shadow: 0 0 24px -6px rgb(62 123 250 / 0.5);
  }
  .mini-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 8px;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: #121214;
    color: #f5f5f5;
  }
  .mini-text {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }
  .mini-text strong {
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.1;
  }
  .mini-text span {
    font: 400 0.7rem/1.1 var(--lp-mono);
    color: #a3a3a3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---------- Closing ---------- */
  .closing {
    position: relative;
    isolation: isolate;
    padding: clamp(7rem, 14vw, 11rem) 1.25rem clamp(5rem, 10vw, 8rem);
  }
  .closing .sky-glow {
    top: 12%;
  }
  .closing-title {
    margin: 0;
    font-size: clamp(2.4rem, 5.4vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.055em;
    font-weight: 400;
    text-wrap: balance;
  }
  .closing .dl-label,
  .closing .dl-row {
    animation: none;
  }
  .closing-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin: 2rem 0 0;
    color: #d4d4d4;
  }
  .closing-links a {
    color: inherit;
    text-decoration: none;
  }
  .closing-links a:first-child {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .closing-links a:hover {
    color: #fff;
  }

  /* ---------- FAQ ---------- */
  .faq {
    display: grid;
    justify-items: center;
    padding: clamp(3rem, 8vw, 5rem) 1.25rem 0;
  }
  .faq-title {
    margin: 0 0 3.5rem;
    font-size: clamp(2.2rem, 4vw, 2.75rem);
    letter-spacing: -0.05em;
    font-weight: 400;
  }
  .faq-list {
    width: min(100%, 52rem);
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }
  .faq details {
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    interpolate-size: allow-keywords;
  }
  .faq details::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 300ms var(--frogg-ease),
      content-visibility 300ms allow-discrete;
  }
  .faq details[open]::details-content {
    height: auto;
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.6rem 0;
    font-size: 1.15rem;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary svg {
    flex: none;
    color: #d4d4d4;
    transition: transform var(--frogg-med) var(--frogg-ease);
  }
  .faq details[open] summary svg {
    transform: rotate(180deg);
  }
  .faq details p {
    margin: 0;
    padding: 0 2.5rem 1.6rem 0;
    color: #a3a3a3;
    font-size: 1.02rem;
